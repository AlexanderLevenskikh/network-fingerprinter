# Copy to .env, or start directly with: docker compose --env-file .env.example up -d --build
# DEMO credentials only. Services publish on loopback by default.
BIND_ADDRESS=127.0.0.1
ELASTIC_PORT=9200
KIBANA_PORT=5601
ANALYST_PORT=3000

# Deliberately unchanged until Step 3: the legacy app and clients use ES 7.x.
ELK_VERSION=7.4.1
ES_HEAP=512m
ELASTIC_PASSWORD=local-elastic-change-me

# PostgreSQL minor version pinned for reproducible first installation.
POSTGRES_VERSION=16.16-alpine
POSTGRES_USER=fingerprinter
POSTGRES_PASSWORD=local-db-change-me
POSTGRES_DB=analytics

# Automatically seeded only when the postgres-data volume is empty.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=local-admin-change-me

APP_ID=1
SESSION_SECRET=local-only-session-secret-change-before-deploying

# Linux host packet capture is opt-in; set a real Linux host interface.
SENSOR_ID=1
SENSOR_INTERFACE=
